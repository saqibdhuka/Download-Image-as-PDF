{
  "manifest_version": 3,
  "name": "Download Image as PDF",
  "version": "1.1",
  "description": "Browser extension that lets you download an image as a PDF directly within the browser.",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings"
  },
  "icons": {
    "128": "icon.png"
  }
}