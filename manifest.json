{
  "manifest_version": 3,
  "name": "Image to PDF",
  "version": "1.2.0",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "offscreen",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}